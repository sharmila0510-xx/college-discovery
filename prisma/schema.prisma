generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  image     String?
  createdAt DateTime @default(now())

  savedColleges SavedCollege[]
  questions     Question[]
  answers       Answer[]
}

model College {
  id          String   @id @default(cuid())
  name        String
  location    String
  state       String
  type        String
  fees        Int
  rating      Float
  ranking     Int?
  avgPackage  Float?
  image       String?
  overview    String?
  createdAt   DateTime @default(now())

  courses   Course[]
  savedBy   SavedCollege[]
  questions Question[]
}

model Course {
  id        String  @id @default(cuid())
  name      String
  duration  String
  fees      Int
  collegeId String
  college   College @relation(fields: [collegeId], references: [id])
}

model SavedCollege {
  id        String  @id @default(cuid())
  userId    String
  collegeId String
  user      User    @relation(fields: [userId], references: [id])
  college   College @relation(fields: [collegeId], references: [id])

  @@unique([userId, collegeId])
}

model Question {
  id        String   @id @default(cuid())
  title     String
  body      String?
  tag       String?
  createdAt DateTime @default(now())
  userId    String
  collegeId String?
  user      User     @relation(fields: [userId], references: [id])
  college   College? @relation(fields: [collegeId], references: [id])

  answers Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  body       String
  createdAt  DateTime @default(now())
  userId     String
  questionId String
  user       User     @relation(fields: [userId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])
}